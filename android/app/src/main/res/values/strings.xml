    <!-- Vice City test modes -->
    <string name="perf_title">Vice City performance comparison</string>
    <string name="perf_description">Each option starts the game. Play for at least 30 seconds from the same save and place, then quit the game and try the next one.\nResults are added up and saved every 5 seconds; restarting the game doesn’t overwrite them. All tests use the iPhone 4S, 1× rendering and filters of the same smoothness.\nStarting the game normally doesn’t run a test.</string>
    <string name="perf_choice_a">A · HD (960×640)</string>
    <string name="perf_choice_b">B · Low resolution (480×320)</string>
    <string name="perf_choice_c">C · HD + less logging</string>
    <string name="perf_choice_d">D · Low resolution + less logging</string>
    <string name="perf_view_reports">View/share all test reports</string>
    <string name="perf_clear_reports">Clear test reports</string>
    <string name="perf_clear_title">Clear the performance test reports?</string>
    <string name="perf_clear_message">Only the test results are removed. Games and saves are kept.</string>
    <string name="reports_cleared">Test reports cleared.</string>
    <string name="clear_failed">Couldn’t clear them.</string>

    <string name="audio_title">Vice City sound comparison</string>
    <string name="audio_description">Each option starts the game. Pick up the same kind of item in the same place and compare the pop.\nSmoothing is experimental and may soften the start of short sounds. Music streams are left as they are.\nAs soon as you hear a noise, tap “%1$s” at the top of the screen, keep playing for a few seconds, then quit and share the report.\nA mark saves the state of nearby sound sources and a little recent sound data. It doesn’t record the microphone or turn on performance timing. Starting the game normally restores the original sound.</string>
    <string name="audio_original">Original sound (for reference)</string>
    <string name="audio_smooth_edges">Smooth the start and end of short sounds</string>
    <string name="audio_lower_volume">Halve the volume of short sounds</string>
    <string name="audio_view_report">View/share test report</string>
    <string name="no_test_results">No test results yet. Choose a test setting to start the game first.</string>
    <string name="test_report_title">Test report (last 64 KB)</string>
    <string name="share_test_report">Share test report</string>

